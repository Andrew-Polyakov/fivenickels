
    :host {
      display: block;
      width: 100%;
      font-family: var(--font-sans, 'Roboto', system-ui, -apple-system, 'Segoe UI', sans-serif);
    }
    .taxonomy-chip-widget {
      width: 100%;
      display: block;
      font-family: inherit;
    }
    .taxonomy-chip-widget__set {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      align-items: center;
      justify-content: flex-start;
    }
    .taxonomy-chip-widget__chip {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }
    .taxonomy-chip-widget__chip--active {
      background: var(--neon-green, #4ade80);
      color: #0a0f14;
      border-color: transparent;
      box-shadow: 0 0 28px rgba(74, 222, 128, 0.9);
    }
    .taxonomy-chip-widget__chip--active .taxonomy-chip-widget__link-btn,
    .taxonomy-chip-widget__chip--active .taxonomy-chip-widget__label,
    .taxonomy-chip-widget__chip--active .mat-icon {
      color: #0a0f14;
    }
    .taxonomy-chip-widget__link-btn {
      border: none;
      background: transparent;
      color: inherit;
      font: inherit;
      cursor: pointer;
      padding: 0;
      margin: 0;
      text-align: left;
    }
    .taxonomy-chip-widget__label {
      color: inherit;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
    }
    .taxonomy-chip-widget__edit-btn {
      border: none;
      background: transparent;
      padding: 0;
      margin: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      pointer-events: auto;
      position: relative;
      z-index: 3;
      line-height: 0;
      border-radius: 999px;
    }
    .taxonomy-chip-widget__edit-btn:focus-visible {
      outline: 2px solid var(--neon-green, #4ade80);
      outline-offset: 2px;
    }
    .taxonomy-chip-widget__edit-glyph {
      pointer-events: none;
      display: block;
      flex-shrink: 0;
    }
    .taxonomy-chip-widget__add-chip {
      cursor: pointer;
    }
    .taxonomy-chip-widget__remove-btn {
      border: none;
      background: transparent;
      color: inherit;
      cursor: pointer;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .taxonomy-chip-widget__add-chip-icon {
      font-size: 1rem;
      width: 1rem;
      height: 1rem;
    }
  