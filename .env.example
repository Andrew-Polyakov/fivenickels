# StockCrawler credentials (trades/ root, gitignored): copy to `.env` and/or `.apca` (same key=value format).
# The app reads a file *directly* first: walks up and finds `.apca`, `alpacacredentials`, or `.env` in that order.
# Lines like `# APCA_API_KEY_ID=...` are still picked up (one leading # stripped). Prefer uncommented for clarity.
# Match paper vs live in the dashboard to: ALPACA_ENV=paper   or   ALPACA_ENV=live
#
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# ALPACA_ENV=paper

# Market data base URL (Django: home.alpaca_market_client / alpaca_bars_client). Leave unset for defaults.
# Live: https://data.alpaca.markets — broker sandbox: https://data.sandbox.alpaca.markets
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Use only with broker-partner sandbox keys (not the same as ALPACA_ENV=paper for normal accounts):
# ALPACA_DATA_SANDBOX=1

# Historical bars feed for wigtail stock charts (GET /v2/stocks/bars). Matches StockCrawler IEX default.
# iex = free-tier friendly; sip = consolidated SIP (paid subscription). See Alpaca market data docs.
# ALPACA_BARS_FEED=iex

# Bar adjustment (Alpaca ``adjustment`` query param). Default in code is ``split`` (split-adjusted), closer to typical broker/TV dailies.
# raw | split | dividend | spin-off | all | comma-separated combos. Use none or - to omit the param (Alpaca default).
# https://docs.alpaca.markets/reference/stockbars
# ALPACA_BARS_ADJUSTMENT=split

# --- Postgres (docker-compose service `postgres`, two app DBs) ---
# Wagtail/Django and the C# StockCrawler both require Postgres
# (see wigtail/mysite/settings/base.py). Configure POSTGRES_* and
# per-app DB names below.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=trades
POSTGRES_PASSWORD=trades
WAGTAIL_POSTGRES_DB=wagtail
CRAWLER_POSTGRES_DB=crawler

# --- Wigtail automated article submission (tools/submit-article, POST /api/articles/auto-submit/) ---
# Generate once and use the same value in Wagtail and tools/pipeline.py:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ARTICLE_SUBMIT_BEARER_TOKEN=
# WIGTAIL_ARTICLE_SUBMIT_URL=http://127.0.0.1:8000/api/articles/auto-submit/
# ARTICLE_SUBMIT_DEFAULT_SECTION_SLUG=information-technology
# ARTICLE_SUBMIT_DEFAULT_AUTHOR_NAME=Fivenickels Editorial
# ARTICLE_SUBMIT_USER=

# --- Local Ollama enrichment (tools/enrich-articles-ollama.py, tools/pipeline.py --enrich-ollama) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=vanilj/palmyra-fin-70b-32k:latest
# OLLAMA_TIMEOUT=120
# OLLAMA_RETRIES=1
# OLLAMA_RETRY_DELAY=1.0
# OLLAMA_ENRICHMENT_PROMPTS_FILE=config/ollama-enrichment-prompts.json
# OLLAMA_ENRICHMENT_SYSTEM_PROMPT=
# OLLAMA_ENRICHMENT_USER_PROMPT=
