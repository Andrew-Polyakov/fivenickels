# StockCrawler credentials (trades/ root, gitignored): copy to `.env` and/or `.apca` (same key=value format).
# The app reads a file *directly* first: walks up and finds `.apca`, `alpacacredentials`, or `.env` in that order.
# Lines like `# APCA_API_KEY_ID=...` are still picked up (one leading # stripped). Prefer uncommented for clarity.
# Match paper vs live in the dashboard to: ALPACA_ENV=paper   or   ALPACA_ENV=live
#
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# ALPACA_ENV=paper

# --- Postgres (docker-compose service `postgres`, two app DBs) ---
# Wagtail/Django and the C# StockCrawler both require Postgres
# (see wigtail/mysite/settings/base.py). Configure POSTGRES_* and
# per-app DB names below.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=trades
POSTGRES_PASSWORD=trades
WAGTAIL_POSTGRES_DB=wagtail
CRAWLER_POSTGRES_DB=crawler
